<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>OnCourse.ABConnect</RootNamespace>
    <AssemblyName>OnCourse.ABConnect</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>OnCourse.ABConnect</PackageId>
    <Version>3.1.0</Version>
    <Company>OnCourse Systems For Education</Company>
    <Authors>OnCourse Systems For Education</Authors>
    <Product>Academic Benchmarks SDK for .NET</Product>
    <Description>Academic Benchmarks API Client</Description>
    <PackageProjectUrl>https://github.com/oncoursesystems/abconnect-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/oncoursesystems/abconnect-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Copyright>Copyright (c) 2023-2026 OnCourse Systems For Education</Copyright>
    <LicenseUrl>https://licenses.nuget.org/MIT</LicenseUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>academic benchmarks academicbenchmarks abconnect instructure</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>instructure.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="System.Threading.RateLimiting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../instructure.png" Pack="true" PackagePath="\" />
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The wire shapes (ABPageDocument, ABResourceDocument, ABFacetEnvelope) and the token bucket
         are internal because they are transport details rather than public vocabulary, but each of
         them decides something the release exists to guarantee: ToPageOrNull returning null is
         precisely where the value-or-throw guarantee is decided, and the bucket's integer accounting is where a lost
         token would hide. They are tested directly rather than only through the client. -->
    <InternalsVisibleTo Include="OnCourse.ABConnect.Tests" />
  </ItemGroup>

</Project>
